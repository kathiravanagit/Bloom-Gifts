# Copy this file to .env and fill in the values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/<database>?retryWrites=true&w=majority&tls=true

# Random secret string for session encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_session_secret_here

# Your deployed Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# Set to 'production' on Render
NODE_ENV=production

# Port (Render sets this automatically, leave blank locally)
# PORT=3000
